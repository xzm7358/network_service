#!/bin/sh

SOCKET_PATH=${NETWORK_SERVICE_SOCKET:-/tmp/smart_hmi_network.sock}
ETH_IFACE=${NETWORK_SERVICE_ETH:-eth0}
WIFI_IFACE=${NETWORK_SERVICE_WIFI:-wlan0}
EVENT_DIR=${NETWORK_SERVICE_EVENT_DIR:-/var/run/wpa_supplicant}
CONFIG_DIR=${NETWORK_SERVICE_CONFIG_DIR:-/dnake/data}
BIN=${NETWORK_SERVICE_BIN:-/dnake/bin/network_service}
RESTART_DELAY=${NETWORK_SERVICE_RESTART_DELAY:-2}
START_CHECK_SECONDS=${NETWORK_SERVICE_START_CHECK_SECONDS:-4}
SUPERVISOR_PIDFILE=${NETWORK_SERVICE_SUPERVISOR_PIDFILE:-/tmp/network_service_supervisor.pid}
CHILD_PIDFILE=${NETWORK_SERVICE_CHILD_PIDFILE:-/tmp/network_service.pid}
SUPERVISOR_LOCKDIR=${NETWORK_SERVICE_SUPERVISOR_LOCKDIR:-/tmp/network_service_supervisor.lock}
SCRIPT_BASENAME=${0##*/}

is_numeric_pid() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    *) [ "$1" -gt 1 ] 2>/dev/null ;;
  esac
}

read_pidfile() {
  pidfile=$1
  pid=
  [ -r "$pidfile" ] || return 1
  IFS= read -r pid < "$pidfile" || return 1
  is_numeric_pid "$pid" || return 1
  printf '%s\n' "$pid"
}

read_cmdline() {
  pid=$1
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null
}

supervisor_pid_valid() {
  pid=$1
  is_numeric_pid "$pid" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmdline=$(read_cmdline "$pid") || return 1
  case "$cmdline" in
    *"$SCRIPT_BASENAME"*" supervise"*) return 0 ;;
    *) return 1 ;;
  esac
}

child_pid_valid() {
  pid=$1
  is_numeric_pid "$pid" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  cmdline=$(read_cmdline "$pid") || return 1
  case "$cmdline" in
    *"$BIN"*) return 0 ;;
    *) return 1 ;;
  esac
}

current_supervisor_pid() {
  pid=$(read_pidfile "$SUPERVISOR_PIDFILE") || return 1
  supervisor_pid_valid "$pid" || return 1
  printf '%s\n' "$pid"
}

current_child_pid() {
  pid=$(read_pidfile "$CHILD_PIDFILE") || return 1
  child_pid_valid "$pid" || return 1
  printf '%s\n' "$pid"
}

cleanup_stale_supervisor_artifacts() {
  pid=$(read_pidfile "$SUPERVISOR_PIDFILE" 2>/dev/null) || pid=
  if [ -z "$pid" ] || ! supervisor_pid_valid "$pid"; then
    rm -f "$SUPERVISOR_PIDFILE"
    rmdir "$SUPERVISOR_LOCKDIR" 2>/dev/null || true
  fi

  pid=$(read_pidfile "$CHILD_PIDFILE" 2>/dev/null) || pid=
  if [ -z "$pid" ] || ! child_pid_valid "$pid"; then
    rm -f "$CHILD_PIDFILE"
  fi
}

run_supervisor() {
  cleanup_stale_supervisor_artifacts

  if ! mkdir "$SUPERVISOR_LOCKDIR" 2>/dev/null; then
    pid=$(current_supervisor_pid 2>/dev/null) || pid=
    if [ -n "$pid" ]; then
      echo "network_service supervisor already active: pid=$pid"
      return 0
    fi
    rmdir "$SUPERVISOR_LOCKDIR" 2>/dev/null || true
    if ! mkdir "$SUPERVISOR_LOCKDIR" 2>/dev/null; then
      echo "network_service supervisor ownership rejected"
      return 4
    fi
  fi

  echo "$$" > "$SUPERVISOR_PIDFILE" || {
    rmdir "$SUPERVISOR_LOCKDIR" 2>/dev/null || true
    return 4
  }

  stopping=0
  child_pid=
  final_rc=0

  request_stop() {
    stopping=1
    if [ -n "$child_pid" ] && child_pid_valid "$child_pid"; then
      kill -TERM "$child_pid" 2>/dev/null || true
    fi
  }

  trap 'request_stop' TERM INT HUP

  while [ "$stopping" -eq 0 ]; do
    "$BIN" \
      --socket "$SOCKET_PATH" \
      --eth "$ETH_IFACE" \
      --wifi "$WIFI_IFACE" \
      --config-dir "$CONFIG_DIR" \
      --event-dir "$EVENT_DIR" &
    child_pid=$!
    echo "$child_pid" > "$CHILD_PIDFILE"

    wait "$child_pid"
    rc=$?
    rm -f "$CHILD_PIDFILE"
    child_pid=

    [ "$stopping" -ne 0 ] && break

    # Exit code 3 is the daemon's explicit singleton-ownership rejection. Another
    # valid owner exists, so a second supervisor must not create a crash loop.
    if [ "$rc" -eq 3 ]; then
      echo "network_service ownership rejected; supervisor stopping"
      final_rc=3
      break
    fi

    echo "network_service exited unexpectedly: rc=$rc; restart in ${RESTART_DELAY}s"
    sleep "$RESTART_DELAY"
  done

  trap - TERM INT HUP
  rm -f "$CHILD_PIDFILE" "$SUPERVISOR_PIDFILE"
  rmdir "$SUPERVISOR_LOCKDIR" 2>/dev/null || true
  return "$final_rc"
}

start_service() {
  echo "Starting network_service supervisor..."
  mkdir -p /tmp
  cleanup_stale_supervisor_artifacts

  pid=$(current_supervisor_pid 2>/dev/null) || pid=
  if [ -n "$pid" ]; then
    echo "network_service supervisor already running: pid=$pid"
    return 0
  fi

  # Invoke through /bin/sh rather than relying on executable mode of the init
  # script itself. This is valid for BusyBox ash and also keeps host regressions
  # faithful when repository file-mode metadata is unavailable.
  sh "$0" supervise &
  launched_pid=$!

  elapsed=0
  while [ "$elapsed" -lt "$START_CHECK_SECONDS" ]; do
    supervisor_pid=$(current_supervisor_pid 2>/dev/null) || supervisor_pid=
    child_pid=$(current_child_pid 2>/dev/null) || child_pid=
    if [ -n "$supervisor_pid" ] && [ -n "$child_pid" ]; then
      echo "network_service started: supervisor=$supervisor_pid child=$child_pid"
      return 0
    fi

    if ! kill -0 "$launched_pid" 2>/dev/null; then
      wait "$launched_pid"
      rc=$?
      supervisor_pid=$(current_supervisor_pid 2>/dev/null) || supervisor_pid=
      if [ -n "$supervisor_pid" ]; then
        echo "network_service supervisor already running: pid=$supervisor_pid"
        return 0
      fi
      echo "network_service supervisor failed to start: rc=$rc"
      return "$rc"
    fi

    sleep 1
    elapsed=$((elapsed + 1))
  done

  supervisor_pid=$(current_supervisor_pid 2>/dev/null) || supervisor_pid=
  if [ -n "$supervisor_pid" ]; then
    echo "network_service supervisor running; child is restarting: pid=$supervisor_pid"
    return 0
  fi

  echo "network_service supervisor did not become ready"
  return 1
}

stop_service() {
  echo "Stopping network_service supervisor..."
  owned=0
  supervisor_pid=$(current_supervisor_pid 2>/dev/null) || supervisor_pid=
  child_pid=$(current_child_pid 2>/dev/null) || child_pid=

  if [ -n "$supervisor_pid" ]; then
    owned=1
    kill -TERM "$supervisor_pid" 2>/dev/null || true
    elapsed=0
    while supervisor_pid_valid "$supervisor_pid" && [ "$elapsed" -lt 5 ]; do
      sleep 1
      elapsed=$((elapsed + 1))
    done
    if supervisor_pid_valid "$supervisor_pid"; then
      echo "network_service supervisor did not stop; forcing pid=$supervisor_pid"
      kill -KILL "$supervisor_pid" 2>/dev/null || true
    fi
  fi

  # Fallback only for a child whose exact binary identity is still verified. This
  # covers a supervisor that was killed abruptly without reverting to killall.
  if [ -n "$child_pid" ] && child_pid_valid "$child_pid"; then
    owned=1
    kill -TERM "$child_pid" 2>/dev/null || true
  fi

  rm -f "$SUPERVISOR_PIDFILE" "$CHILD_PIDFILE"
  rmdir "$SUPERVISOR_LOCKDIR" 2>/dev/null || true
  if [ "$owned" -eq 1 ]; then
    rm -f "$SOCKET_PATH"
  fi
}

status_service() {
  supervisor_pid=$(current_supervisor_pid 2>/dev/null) || supervisor_pid=
  if [ -z "$supervisor_pid" ]; then
    echo "network_service stopped"
    return 3
  fi

  child_pid=$(current_child_pid 2>/dev/null) || child_pid=
  if [ -n "$child_pid" ]; then
    echo "network_service running: supervisor=$supervisor_pid child=$child_pid"
    return 0
  fi

  echo "network_service supervisor running; child restarting: supervisor=$supervisor_pid"
  return 1
}

case "$1" in
  start)
    start_service
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    sleep 1
    start_service
    ;;
  status)
    status_service
    ;;
  supervise)
    run_supervisor
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
